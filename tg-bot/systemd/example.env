# Copy to /etc/tg-bot/<session_name>.env (same <session_name> used in
# `systemctl start tg-bot@<session_name>`). EnvironmentFile is read by the
# tg-bot@.service unit template.
#
# TG_SESSION is set automatically by the unit from the instance name — do NOT
# duplicate it here, otherwise accidental edits can cause sessions to collide.

TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789
SUPABASE_URL=https://dwrpellubzpjblmffmqv.supabase.co
SUPABASE_KEY=__service_role_or_anon_key__
XAI_API_KEY=__xai_key__

# Optional: seconds between analysis cycles (default 1800)
# ANALYSIS_INTERVAL=1800

# Optional: chat id for escalation alerts
# ALERT_CHAT_ID=-100xxxxxxxxxx
